# ---- Python ----
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
.venv
.ruff_cache/
.pytest_cache/

# Keep the package root clean — source lives under src/
/*.py

# ---- Environment / secrets ----
.env
.env.*
!.env.example
.envrc

# ---- Editor / OS ----
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- GRC agent runtime artifacts ----
# Backups, locks, and undo snapshots written next to loaded .grc files
.grc_agent/
# Trace-dataset planning/export workspace (local analysis artifacts)
grc_trace_dataset/
# GRC save/restore scratch variants
*.saved.grc
*.restored.grc
*.tmp.grc

# ---- Test output & Scratch ----
tests/output/
playground/
tmp/

# ---- Local dev planning artifacts ----
*.bak
# Persisted chat sessions (SQLite) — local user transcripts, not source
chat_sessions.db

# Generated vector indexes (per-backend, built on first use — see grc_agent.ingest)
src/grc_agent/vectors/


# experiments/*/ eval & dataset pipelines — generated artifacts only, scripts/fixtures stay tracked
experiments/*/raw_outputs/
experiments/*/reports/
experiments/*/output/
experiments/*/runs/
experiments/*/runs_oneshot/
experiments/*/final_findings_and_causes.md

# ---- Local agent/tool working dirs (not shared) ----
.claude/
.opencode/
.cache/
.context/
unsloth_compiled_cache/
docs/handoff.md
docs/blog.md

# pi harness local state (goals pool, loops, session ledgers)
.pi/
# Local-only dataset-collection harness and every trace it produces
# The harness drives the real app unattended with shell access; it stays out
# of the repository by design. Code, fixtures, campaign DBs, manifests and
# exports are all local-only.
experiments/dataset_collection/
*.campaign/

# ---- Local investigation, planning, and machine-specific evidence ----
/docs/plans/
/docs/investigation/
/docs/handoffs/
/docs/jobs/
/docs/evidence/
/docs/harness_findings.md

# ---- Local databases, test reports, and profiling output ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.log
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.tox/
*.prof
*.pstats
