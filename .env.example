# Qoherent GRC Agent configuration. Copy this file to `.env` and edit:
#   cp .env.example .env
#
# This file is the SINGLE SOURCE OF TRUTH for user-settable chat-agent
# preferences: the active provider, the per-provider chat model names, and the
# cloud API keys. All of these are also editable from the Settings dialog in
# the app's sidebar (which writes them back here), so editing this file by hand
# and editing via the GUI are two views of the same state.
#
# Resolution order for which `.env` is loaded (see grc_agent.settings.env_path):
#   1. GRC_AGENT_ENV env var (explicit path override — used by tests)
#   2. A `.env` in the package repository root (fixed, package-relative)
#   3. ~/.config/grc_agent/.env (stable home for an installed package)
#
# Provider/model/key changes apply immediately on Save (live-swap) — no restart
# needed. The Settings dialog pre-flights the new backend and the toolbar's
# provider badge shows which backend the running agent is actually using.

# --- Active chat provider -----------------------------------------------------
# Which provider the interactive chat agent uses. One of the concrete provider
# ids (see grc_agent.ui.providers.PROVIDER_ORDER):
#   ollama_local       local Ollama daemon (default)
#   ollama_cloud       Ollama Cloud (https://ollama.com/v1) — needs OLLAMA_API_KEY
#   openrouter         OpenRouter — needs OPENROUTER_API_KEY
#   openai             OpenAI API — needs OPENAI_API_KEY
#   openai_compatible  any OpenAI-shaped endpoint (llama.cpp, vLLM, LM Studio,
#                      OpenRouter, OpenAI) — set OPENAI_COMPATIBLE_BASE_URL;
#                      the key is optional for local endpoints
#   anthropic          Anthropic API — needs ANTHROPIC_API_KEY
#   google             Google AI Studio (Gemini) — needs GOOGLE_API_KEY
#   groq               Groq — needs GROQ_API_KEY
#   mistral            Mistral — needs MISTRAL_API_KEY
#   cohere             Cohere — needs COHERE_API_KEY
#   xai                xAI (Grok) — needs XAI_API_KEY
#   openai_codex       ChatGPT Plus/Pro (Codex). Signs in with OAuth from the
#                      Settings dialog, not an API key; tokens live in
#                      ~/.config/grc_agent/openai-codex-auth.json (0600), never
#                      in this file. Needs an active ChatGPT Plus/Pro plan.
GRC_PROVIDER=ollama_local

# --- Chat models (one per provider; only GRC_PROVIDER's value is live) --------
# Ollama chat model (local and cloud share one key). Pull first: ollama pull qwen3.8:latest
OLLAMA_CHAT_MODEL=qwen3.8:latest
# OpenRouter chat model (browse at https://openrouter.ai/models).
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OpenAI API chat model.
OPENAI_MODEL=gpt-5.6-terra
# OpenAI-compatible / llama.cpp chat model name or default.
OPENAI_COMPATIBLE_MODEL=local-model
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_MODEL=gemini-3.7-flash
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=codestral-latest
COHERE_MODEL=north-mini-code-1-0
XAI_MODEL=grok-4.6
# ChatGPT/Codex model (only used when GRC_PROVIDER=openai_codex).
OPENAI_CODEX_MODEL=gpt-5.6-luna

# --- Base URLs (editable for the two shape-agnostic providers) ----------------
# Local Ollama daemon (ollama_local). Ollama Cloud's URL is canonical and
# needs no entry.
OLLAMA_BASE_URL=http://localhost:11434
# Any OpenAI-shaped endpoint (openai_compatible).
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1

# --- API keys (cloud providers; also settable from the Settings dialog) -------
# Ollama: local usually needs no key; Ollama Cloud requires one. The Settings
# dialog writes the cloud key under OLLAMA_API_KEY; OLLAMA_CLOUD_API_KEY is
# still read as a legacy fallback for hand-edited files.
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=

# --- Embeddings backend (catalog/docs vector search) -------------------------
# Chosen independently of GRC_PROVIDER. One of:
#   lexical            fast SQLite FTS5/BM25 keyword search (the default; zero
#                      dependencies or extra runtime required)
#   llamacpp           local vector search via llama.cpp + EmbeddingGemma-300M;
#                      needs nothing installed system-wide. Install it with one
#                      click from the Settings dialog, which downloads into
#                      ~/.local/share/grc-agent.
GRC_EMBED_BACKEND=lexical

# --- Project directory --------------------------------------------------------
# Explicit workspace folder for the agent's filesystem tools. Also settable
# directly from the sidebar folder chooser button at the top of the chat UI.
# If unset, defaults to the current working directory on startup.
GRC_PROJECT_DIR=

# --- Action approval gate ----------------------------------------------------
# Approval mode for tool side effects (flowgraph edits, runs, and shell commands):
#   manual  (default) every proposed side effect pauses for Approve/Deny/Always-accept
#   auto    auto-approves flowgraph mutations and runs; shell commands require approval
#   yolo    auto-approves all actions without asking
# Also controllable from the sidebar composer's Mode toggle (Manual / Auto / YOLO).
GRC_AGENT_APPROVE_CHANGES=manual


